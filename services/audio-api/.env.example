APP_ENV=development
SUPABASE_URL=
SUPABASE_ANON_KEY=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ENABLE_POC_TEST_MODE=true

# POC test mode must be false in production.
# The API validates the user's Supabase JWT and calls PostgREST with that JWT,
# so normal row-level security remains active.
# Do not place production secrets in source control.
